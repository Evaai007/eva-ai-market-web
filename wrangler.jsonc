{
  "$schema": "https://developers.cloudflare.com/workers/wrangler/config-schema.json",
  "name": "eva-ai-market",
  "main": "./worker.js",
  "compatibility_date": "2026-10-02",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*",
      "/v1/*"
    ]
  },
  "previews": {}
}
