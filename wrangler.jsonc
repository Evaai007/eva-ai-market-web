{
  "$schema": "https://developers.cloudflare.com/workers/wrangler/config-schema.json",
  "name": "eva-ai-market",
  "main": "./worker.js",
  "compatibility_date": "2026-10-02",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*",
      "/v1/*"
    ],
    "exclude": [
      "node_modules/**",
      ".git/**",
      ".github/**",
      ".wrangler/**",
      "api/**",
      "supabase/**",
      "worker.js",
      "wrangler.json",
      "wrangler.jsonc",
      ".assetsignore",
      "**/*.sql",
      "_security.js"
    ]
  }
}
