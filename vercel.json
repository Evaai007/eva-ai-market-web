{
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/v1/messages",
      "destination": "/api/v1/claude?compat=anthropic"
    },
    {
      "source": "/v1/models",
      "destination": "/models.json"
    },
    {
      "source": "/api/admin/stats",
      "destination": "/api/admin/store?view=stats"
    },
    {
      "source": "/api/public-activity",
      "destination": "/api/health?view=activity"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {"key":"X-Content-Type-Options","value":"nosniff"},
        {"key":"X-Frame-Options","value":"DENY"},
        {"key":"Referrer-Policy","value":"strict-origin-when-cross-origin"},
        {"key":"Permissions-Policy","value":"camera=(), microphone=(), geolocation=()"},
        {"key":"Strict-Transport-Security","value":"max-age=31536000; includeSubDomains"},
        {"key":"Cross-Origin-Opener-Policy","value":"same-origin"},
        {"key":"X-DNS-Prefetch-Control","value":"off"}
      ]
    },
    {
      "source": "/eva-ops-93k7m2",
      "headers": [
        {"key":"Cache-Control","value":"no-store, max-age=0"},
        {"key":"X-Robots-Tag","value":"noindex, nofollow, noarchive"}
      ]
    },
    {
      "source": "/(.*).js",
      "headers": [
        {"key":"Cache-Control","value":"no-cache, must-revalidate"}
      ]
    }
  ]
}
